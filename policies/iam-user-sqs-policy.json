{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAssignmentQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:DeleteQueue"
      ],
      "Resource": "<QUEUE_ARN>"
    }
  ]
}
