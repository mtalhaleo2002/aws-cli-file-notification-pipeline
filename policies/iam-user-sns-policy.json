{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAssignmentTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:Subscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:Publish",
        "sns:DeleteTopic"
      ],
      "Resource": "<TOPIC_ARN>"
    }
  ]
}
